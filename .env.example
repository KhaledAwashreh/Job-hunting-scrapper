# LLM Configuration (Model-Agnostic)
# Choose your provider: anthropic, openai, ollama

# Anthropic (Claude) - Default
ANTHROPIC_API_KEY=your_claude_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MODEL_FAST=claude-3-haiku-20250305

# Optional: OpenAI (Alternative to Claude)
# OPENAI_API_KEY=your_openai_key_here

# Optional: Ollama (Local LLM, free)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=mistral

# Optional: Model selection per use case (override defaults)
# SCORING_PROVIDER=anthropic
# EXTRACTION_PROVIDER=anthropic
# MCP_PROVIDER=anthropic

# Firecrawl API (Replaces Playwright for smarter scraping)
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Optional: Custom job search keywords
# DEFAULT_KEYWORDS=software engineer

# Optional: Default countries to search
# DEFAULT_COUNTRIES=Ireland,Spain,Netherlands

# Optional: Proxy settings for scraping
# HTTP_PROXY=
# HTTPS_PROXY=
