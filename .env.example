# LLM Configuration (Model-Agnostic)
# Choose your provider: anthropic, openai, ollama

# Anthropic (Claude) - Default
ANTHROPIC_API_KEY=your_claude_key_here
# Model IDs are NOT set here on purpose. src/config.js already defaults to
# current models; setting these overrides that default, and stale IDs 404.
# Only uncomment to pin a specific model.
# CLAUDE_MODEL=
# CLAUDE_MODEL_FAST=

# Optional: OpenAI
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o
# Point at any OpenAI-protocol service (vLLM, a gateway, LM Studio):
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: DeepSeek / Groq / Together / OpenRouter
# These speak the OpenAI protocol and need no extra packages.
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=

# Optional: Ollama (Local LLM, free). Note: no /v1 suffix — the client calls
# the native /api/chat endpoint, not the OpenAI-compatible one.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# Optional: provider selection per use case. Any of:
#   anthropic | openai | ollama | deepseek | groq | together | openrouter
# SCORING_PROVIDER=anthropic
# TRANSLATION_PROVIDER=anthropic
# EXTRACTION_PROVIDER=anthropic
# MCP_PROVIDER=anthropic

# Firecrawl API (Replaces Playwright for smarter scraping)
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Optional: Custom job search keywords
# DEFAULT_KEYWORDS=software engineer

# Optional: Default countries to search
# DEFAULT_COUNTRIES=Ireland,Spain,Netherlands

# Optional: Proxy settings for scraping
# HTTP_PROXY=
# HTTPS_PROXY=
