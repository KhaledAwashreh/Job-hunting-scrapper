
FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install --production

# Copy source code
COPY src ./src

# Create necessary directories
RUN mkdir -p /app/data/resumes /app/public

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=test
ENV PORT=3000

# Run the application
CMD ["node", "src/server.js"]
